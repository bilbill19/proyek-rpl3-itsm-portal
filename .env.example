# ==============================================================================
# IT SERVICE MANAGEMENT (ITSM) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi .env dan sesuaikan nilainya sesuai lingkungan Anda.
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL + Prisma ORM)
# ------------------------------------------------------------------------------
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/itsm_db?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (JWT + Bcrypt)
# ------------------------------------------------------------------------------
# Secret key untuk signing JWT token session dan reset password
JWT_SECRET="" # Generate at least 32 random characters before starting auth

# ------------------------------------------------------------------------------
# 3. APPLICATION URL CONFIGURATION
# ------------------------------------------------------------------------------
# URL dasar aplikasi untuk redirection dan base routing
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. MODULAR AI ASSISTANT CONFIGURATION
# ------------------------------------------------------------------------------
# Pilihan provider AI:
# - expert    : (Default) Dedicated Offline Domain Expert Engine (100% Reliable, Zero API Key)
# - nvidia    : NVIDIA NIM / NVIDIA API Catalog (memerlukan NVIDIA_API_KEY)
# - gemini    : Google Gemini Generative AI (memerlukan GEMINI_API_KEY)
# - openai    : OpenAI ChatGPT API (memerlukan OPENAI_API_KEY)
# - anthropic : Anthropic Claude API (memerlukan ANTHROPIC_API_KEY)
# - ollama    : Local LLM Engine (Llama 3 / Mistral / DeepSeek via Ollama)
AI_PROVIDER="expert"

# NVIDIA NIM Configuration (Chatbot Beranda + AI Assistant Dashboard)
# Endpoint: https://integrate.api.nvidia.com/v1/chat/completions
# Dapatkan API key di https://build.nvidia.com -> Get API Key
# SECURITY: isi HANYA di .env lokal. JANGAN commit nilai aslinya ke Git.
NVIDIA_API_KEY=""
NVIDIA_KEY_ID=""
NVIDIA_MODEL="mistralai/mistral-large-2-instruct"

# Google Gemini Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI Configuration
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-4o-mini"

# Anthropic Claude Configuration
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Local Ollama Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Universal fallback API key (jika menggunakan konfigurasi generik)
AI_API_KEY=""
